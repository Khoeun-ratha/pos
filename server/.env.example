# Copy to .env and fill in. Open the same database in Navicat:
#   Connection type: MySQL, Host: localhost, Port: 3306, User/Password: as below, Database: pos_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_db

# true = fill an empty database with demo products, customers and 30 days of sales
POS_SEED=true
